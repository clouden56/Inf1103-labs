FROM python:3.11-slim

WORKDIR /app

COPY supplier.py product.py physical_product.py digital_product.py can_be_shipped.py \
     inventory.py order.py inventory_storage.py inventory_manager.py \
     test_lab07.py test_lab08.py lab08_demo.py ./

# inventory.json is read from /app, so mounting the project folder
# (-v "${PWD}:/app") uses the local code and inventory.json directly
CMD ["python", "inventory_manager.py"]
